server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # IMPORTANTE: sin "keepalive" hacia el backend. Cada petición abre una conexión
    # nueva y así el balanceo (kube-proxy / DNS) reparte entre pods. Con keepalive,
    # muchas peticiones se pegarían a las mismas conexiones y el reparto se vería sesgado.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }

    location /loadgen/ {
        proxy_pass http://${LOADGEN_HOST}:${LOADGEN_PORT}/;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
